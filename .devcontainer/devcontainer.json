{
  "name": "TioDaPerua Frontend (Expo Web)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",
  "workspaceFolder": "/workspaces/frontendreact",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Frontend (Expo Web)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
